# Which system is the source of truth for invoices/payments: zoho | tally
PRIMARY_SOURCE=zoho

# Zoho Books (Saudi data centre). Create a Self Client at https://api-console.zoho.sa
ZOHO_ACCOUNTS_URL=https://accounts.zoho.sa
ZOHO_API_URL=https://www.zohoapis.sa/books/v3
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# Shared secret the Tally sync agent sends as "Authorization: Bearer <token>"
TALLY_INGEST_TOKEN=

# Optional: protect the dashboard itself with HTTP basic auth (user:password)
DASHBOARD_AUTH=

PORT=3000
CACHE_TTL_SECONDS=300
CURRENCY=SAR
